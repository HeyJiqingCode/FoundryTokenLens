{
  "name": "foundry-token-lens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"node scripts/dev-api.mjs\" \"vite\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/web",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.33.0",
    "@fastify/static": "10.1.3",
    "@internationalized/date": "3.12.4",
    "better-auth": "1.7.4",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-syntax-typescript": "7.29.7",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.45.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  }
}
